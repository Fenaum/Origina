# Copy this to .env and fill in real values before running locally.
# Never commit .env to git.

# ── Required ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://origina:origina123@localhost:5432/originadb

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# In local dev, the insecure default is tolerated but not recommended.
# In staging/prod (APP_ENV != local), the server refuses to start with this default.
JWT_SECRET_KEY=change-me-in-production

# ── Optional (defaults shown) ───────────────────────────────────────────────────
APP_ENV=local
LOG_LEVEL=debug
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=/tmp/origina-uploads
MAX_UPLOAD_SIZE_MB=50
# ── Tenant bootstrap (Sprint 5 §5.3) ──────────────────────────────────────────
# Operator-only secret required to call POST /tenants/bootstrap. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leave blank to disable tenant creation entirely.
ADMIN_SECRET=
