t_id uuid not null references tenants(id) on delete restrict,\n67\t  loan_id uuid not null references loans(id) on delete cascade,\n68\t\n69\t  --- 1003 URLA | Loan Application fields\n70\t  type borrower_type not null,\n71\t  first_name text,\n72\t  last_name text,\n73\t  ssn_last4 char(4),\n74\t  ssn_encrypted bytea,\n75\t  dob date,\n76\t  phone text,\n77\t  email text,\n78\t  current_address_id uuid references addresses(id) on delete set null,\n79\t  mailing_address_id uuid references addresses(id) on delete set null,\n80\t  borrower_relationship borrower_relationship,\n81\t  income_type borrower_income_type,\n82\t  income_amount numeric,\n83\t\n84\t  --- Demographic info\n85\t    ethnicity text,\n86\t    race text,\n87\t    gender text,\n88\t    marital_status text,\n89\t    dependents integer,\n90\t    employment_status text,\n91\t    employer_name text,\n92\t    job_title text,\n93\t    years_on_job integer,\n94\t    years_in_profession integer,\n95\t    work_phone text,\n96\t    work_email text,\n97\t\n98\t    --- Timestamps\n99\t  created_at timestamptz not null default now(),\n100\t  updated_at timestamptz not null default now()\n101\t);\n102\t"}]},"parent_tool_use_id":null,"session_id":"55eb2621-392e-4dfe-86a2-bbe134f6bbdc","uuid":"609802f1-2fad-4300-83dd-dd0093480018","timestamp":"2026-04-27T17:43:59.031Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/fenaum/Projects/Origina/db/migrations/101_borrowers.sql","content":"-- ==================\n-- NOTE: fixed enum syntax (values must be quoted, no trailing comma)\n-- =========================================\ndo $$\nbegin\n  if not exists (select 1 from pg_type where typname = 'borrower_type') then\n    create type borrower_type as enum (\n      'primary_borrower',\n      'co_borrower',\n      'guarantor',\n      'other'\n    );\n  end if;\nend $$;\n\ndo $$\nbegin\n  if not exists (select 1 from pg_type where typname = 'borrower_relationship') then\n    create type borrower_relationship as enum